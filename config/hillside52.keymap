#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/backlight.h>

#define DEFAULT_L 0
#define NUM_NAV_L 1
#define SYM_L     2
#define FN_L      3
#define ADJ_L     4
#define BT_L      5

#define Undo   LC(Z)
#define Cut    LC(X)
#define Copy   LC(C)
#define Paste  LC(V)
#define Redo   LC(Y)
// Mute        &kp  C_MUTE   
// `            &kp  GRAVE

/* Empty secondary layer

/* Symbols
 * -------------------------------------------------------------------------------------------------------------------------------------
 * |       |       |       |       |       |       |-----------------------------------|       |       |       |       |       |       |
 * |       |       |       |       |       |       |-----------------------------------|       |       |       |       |       |       |
 * |       |       |       |       |       |       |       |-------------------|   /   |       |       |       |       |       |       |
 * |       |       |       |-------|       |       |       |       |---|       |       |       |       |-------|       |       |       |

                        bindings = <
&trans        &none         &none         &none         &none         &none                                                                          &none         &none         &none         &none         &none         &trans
&trans        &none         &none         &none         &none         &none                                                                          &none         &none         &none         &none         &none         &trans
&trans        &none         &none         &none         &none         &none         &none                                              &none         &none         &none         &none         &none         &none         &trans
&trans        &trans        &trans                      &none         &none         &trans         &none                 &none         &none         &none         &none                       &trans        &trans        &trans
                        >;

*/

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {

/* DEFAULT
 * -------------------------------------------------------------------------------------------------------------------------------------
 * | ESC   |   Q   |   W   |   E   |   R   |   T   |-----------------------------------|   Y   |   U   |   I   |   O   |   P   | BKSPC |
 * | TAB   |   A   |   S   |   D   |   F   |   G   |-----------------------------------|   H   |   J   |   K   |   L   |   ;   | ENTER |
 * | SHIFT |   Z   |   X   |   C   |   V   |   B   |  ???  |-------------------|  ???  |   N   |   M   |   ,   |   .   |   /   | SHIFT |
 * | CTRL  |  GUI  |  ALT  |-------|ADJUST |  ???  | SPACE |NUM_NAV|---|SYMBOL |FUNCTON|DELETE |ADJUST |-------|  ALT  |  GUI  | CTRL  |
 */
                        bindings = <
&kp  ESC      &kp  Q        &kp  W        &kp  E        &kp  R        &kp  T                                                                         &kp  Y        &kp  U        &kp  I        &kp  O        &kp  P        &kp  BSPC
&kp  TAB      &kp  A        &kp  S        &kp  D        &kp  F        &kp  G                                                                         &kp  H        &kp  J        &kp  K        &kp  L        &kp  SEMI     &kp  ENTER
&kp  LSHFT    &kp  Z        &kp  X        &kp  C        &kp  V        &kp  B        &mo BT_L                                           &mo ADJ_L     &kp  N        &kp  M        &kp  COMMA    &kp  DOT      &kp  SLASH    &kp  RSHFT
&kp  LCTRL    &kp LGUI      &kp LALT                    &mo NUM_NAV_L &kp DEL       &mt NUM_NAV_L SPACE      &mo SYM_L             &mo SYM_L     &mo FN_L      &kp DEL       &mo NUM_NAV_L               &kp  RALT     &kp  RGUI     &kp  LCTRL
                        >;
			
                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
                };
		
                number_layer {
/* Numbers & Navigation
 * -------------------------------------------------------------------------------------------------------------------------------------
 * | trans |       |   7   |   8   |   9   |       |-----------------------------------|K_CMENU|INSERT | PSCRN | SLCK  | PAUSE | trans |
 * | trans |   .   |   4   |   5   |   6   |   0   |-----------------------------------| Left  | Down  |  Up   | Right | CAPS  | trans |
 * | trans |       |   1   |   2   |   3   |       |  ???  |-------------------|  ???  | HOME  | PG DN | PG UP |  END  |       | trans |
 * | trans | trans | trans |-------|       |       | trans |  ???  |---|  ???  |  ???  |  ???  |  ???  |-------| trans | trans | trans |
 */
                        bindings = <
&trans        &none         &kp  N7       &kp  N8       &kp  N9       &none                                                                          &kp K_CMENU   &kp INSERT    &kp PSCRN     &kp SLCK      &kp PAUSE_BREAK &trans
&trans        &kp DOT       &kp  N4       &kp  N5       &kp  N6       &kp  N0                                                                        &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     &kp CAPS      &trans
&trans        &none         &kp  N1       &kp  N2       &kp  N3       &none         &none                                              &none         &kp HOME      &kp PG_DN     &kp PG_UP     &kp END       &none         &trans
&trans        &trans        &trans                      &none         &none         &trans         &none                 &none         &none         &none         &none                       &trans        &trans        &trans
                        >;
			
                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
                };
		
                symbol_layer {
/* Symbols
 * -------------------------------------------------------------------------------------------------------------------------------------
 * | trans |   `   |   &   |   *   |   (   |       |-----------------------------------|   _   |   -   |   (   |   )   |   =   | trans |
 * | trans |   '   |   $   |   %   |   ^   |       |-----------------------------------|   [   |   ]   |   {   |   }   |   \   | trans |
 * | trans |   "   |   !   |   @   |   #   |       |       |-------------------|       |   |   |   +   |   <   |   >   |   /   | trans |
 * | trans | trans | trans |-------|       |       | trans |       |---|       |       |       |       |-------| trans | trans | trans |
 */
                        bindings = <
&trans         &kp GRAVE    &kp AMPS      &kp ASTRK     &kp LPAR      &none                                                                         &kp UNDER     &kp MINUS     &kp LPAR      &kp RPAR      &kp EQUAL     &trans
&trans         &kp SQT      &kp DLLR      &kp PRCNT     &kp CARET     &none                                                                         &kp LBKT      &kp RBKT      &kp LBRC      &kp RBRC      &kp BSLH      &trans
&trans         &kp DQT      &kp EXCL      &kp AT        &kp HASH      &none        &none                                             &none          &kp PIPE      &kp PLUS      &kp LT        &kp GT        &kp FSLH      &trans
&trans         &trans       &trans                      &none         &none        &trans         &none                 &none        &none          &none         &trans                      &trans        &trans        &trans
                        >;
			
                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
                };

                nav_layer {
/* Functions
 * -------------------------------------------------------------------------------------------------------------------------------------
 * | trans |       |  F7   |  F8   |  F9   |       |-----------------------------------|       |  F17  |  F18  |  F19  |  F24  | trans |
 * | trans |       |  F4   |  F5   |  F6   |  F10  |-----------------------------------|  F20  |  F14  |  F15  |  F16  |  F23  | trans |
 * | trans |       |  F1   |  F2   |  F3   |       |  ???  |-------------------|  ???  |       |  F11  |  F12  |  F13  |  F22  | trans |
 * | trans | trans | trans |-------|       |       | trans |  ???  |---|  ???  |  ???  |  ???  |  ???  |-------| trans | trans | trans |
 */
                        bindings = <
&trans        &none         &kp F7        &kp F8        &kp F9        &none                                                                          &none         &kp F17       &kp F18       &kp F19       &kp F24       &trans
&trans        &none         &kp F4        &kp F5        &kp F6        &kp F10                                                                        &kp F20       &kp F14       &kp F15       &kp F16       &kp F23       &trans
&trans        &none         &kp F1        &kp F2        &kp F3        &none         &none                                              &none         &none         &kp F11       &kp F12       &kp F13       &kp F22       &trans
&trans        &trans        &trans                      &none         &none         &trans         &none                 &none         &none         &none         &none                       &trans        &trans        &trans
                        >;
			
                        sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
                };
		
   

                adj_layer {
/* ADJUST
 * -------------------------------------------------------------------------------------------------------------------------------------
 * |BT_CLR |DKNKT 0|DKNKT 1|DKNKT 2|DKNKT 3|DKNKT 4|-----------------------------------|DKNKT 4|DKNKT 3|DKNKT 2|DKNKT 1|DKNKT 0|BT_CLR |
 * |OUT_BLE| BT 0  | BT 1  | BT 2  | BT 3  | BT 4  |-----------------------------------| BT 4  | BT 3  | BT 2  | BT 1  | BT 0  |OUT_BLE|
 * |OUT_USB| EP_ON |EP_OFF |BL_TOG |BL_INC |BL_DEC | BOOTL |-------------------| BOOTL |BL_DEC |BL_INC |BL_TOG |EP_OFF |EP_ON  |OUT_USB|
 * |BT_CLRA|-------| RESET |-------|       |       |       |       |---|       |       |       |       |-------| RESET |-------|BT_CLRA|
 */       
                        bindings = <
&bt BT_CLR       &bt BT_DISC 0     &bt BT_DISC 1      &bt BT_DISC 2   &bt BT_DISC 3   &bt BT_DISC 4                                                                       &bt BT_DISC 4   &bt BT_DISC 3   &bt BT_DISC 2   &bt BT_DISC 1      &bt BT_DISC 0      &bt BT_CLR    
&out OUT_BLE     &bt BT_SEL 0      &bt BT_SEL 1       &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                                                                        &bt BT_SEL 4    &bt BT_SEL 3    &bt BT_SEL 2    &bt BT_SEL 1       &bt BT_SEL 0       &out OUT_BLE  
&out OUT_USB     &ext_power EP_ON  &ext_power EP_OFF  &bl BL_TOG      &bl BL_INC      &bl BL_DEC      &bootloader                                         &bootloader     &bl BL_DEC      &bl BL_INC      &bl BL_TOG      &ext_power EP_OFF  &ext_power EP_ON   &out OUT_USB
&bt BT_CLR_ALL   &none             &sys_reset                         &kp A           &kp D           &kp J          &studio_unlock         &studio_unlock &kp J           &kp D           &kp A                           &sys_reset         &none              &bt BT_CLR_ALL
                        >;
			
                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
                };

        
                bt_layer {
/* BLUETOOTH
 * -------------------------------------------------------------------------------------------------------------------------------------
 * |DKNKT 3|DKNKT 6|DKNKT 7|DKNKT 8|DKNKT 9|DKNKT10|-----------------------------------|DKNKT11|DKNKT12|DKNKT13|DKNKT14|DKNKT15|DKNKT16|
 * | BT 5  | BT 6  | BT 7  | BT 8  | BT 9  | BT 10 |-----------------------------------| BT 11 | BT 12 | BT 13 | BT 14 | BT 15 | BT 16 |
 * |       |       |       |       |       |       |       |-------------------|       |       |       |       |       |       |       |
 * |-------|       |-------|       |       |       |       |       |---|       |       |       |-------|       |-------|       |       |
 */       
                        bindings = <
&bt BT_DISC 5     &bt BT_DISC 6      &bt BT_DISC 7   &bt BT_DISC 8   &bt BT_DISC 9   &bt BT_DISC 10                                                                       &bt BT_DISC 11    &bt BT_DISC 12     &bt BT_DISC 13  &bt BT_DISC 14  &bt BT_DISC 15  &bt BT_DISC 16      
&bt BT_SEL 5      &bt BT_SEL 6       &bt BT_SEL 7    &bt BT_SEL 8    &bt BT_SEL 9    &bt BT_SEL 10                                                                        &bt BT_SEL 11     &bt BT_SEL 12      &bt BT_SEL 13   &bt BT_SEL 14   &bt BT_SEL 15   &bt BT_SEL 16      
&kp B             &kp L              &kp U           &none           &none           &none            &none                                               &none           &kp B             &kp L              &kp U           &none           &none           &none               
&none             &none              &none                           &none           &none            &none          &none                 &none          &none           &none             &none                              &none           &none           &none               
                        >;
			
                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
                };
        };
};
